# Base URL API backend (Laravel), termasuk prefix /api/v1.
#
# Kosongkan di development: host otomatis diturunkan dari Metro dev server
# (Constants.expoConfig.hostUri), sehingga perubahan IP DHCP tidak memutus app.
# Isi eksplisit untuk production build atau mode tunnel, contoh:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
